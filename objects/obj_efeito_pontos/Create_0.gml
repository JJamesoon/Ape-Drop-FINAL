//TEXTO DE PONTOS E EFEITOS. CRIADO PELO EFEITO_TEXTO() / PONTOS_SOMAR() / PONTOS_IRMANDADE() / COLETOR_OBTER()
//(A VARIAVEL NAO PODE SE CHAMAR "TEXTO": JA EXISTE A FUNÇAO TEXTO() DOS IDIOMAS E O JOGO MOSTRAVA "REF SCRIPT TEXTO")
//
//MODOS:
//	"TEXTO"		SOBE E SOME (LEVEL UP, ENERGIA!, COMBO...)
//	"VOAR"		PONTO: DA UM "POP" E VOA ATE O SCORE DO HUD
//	"COLETAR"	BLOCO DA IRMANDADE: "10" NO LUGAR DO BLOCO, DEPOIS VOA ATE O NUMERO DO CENTRO
//	"COLETOR"	NUMERO DA LINHA NO CENTRO DA TELA: SOMA OS 10 QUE CHEGAM E DEPOIS VOA ATE O SCORE
//	"ANEL"		MORTE DA IRMANDADE: ANEL BRANCO QUE CRESCE E SOME
//	"ESTILHACO"	MORTE DA IRMANDADE: MINI-BLOCO DA COR DO BLOCO SAINDO GIRANDO
//	"TELE"		TELEPORTE DA PEÇA: CLARAO E FAÍSCAS NO CHAO ONDE ELA CAIU (Y_CHAO)
modo = "texto";

mensagem = "";	//TEXTO QUE APARECE
cor = c_white;
esc_final = 1;	//TAMANHO FINAL DEPOIS DO POP
esc = 0;		//COMEÇA PEQUENO E DA UM "POP"
alpha = 1;
velv = -1.4;	//SOBE NO MODO TEXTO
timer = 50;	//FRAMES DE VIDA

//VOO
valor = 0;			//PONTOS QUE ESSE TEXTO LEVA
timer_voo = 0;	//TEMPO VOANDO
vel_voo = 0;	//VELOCIDADE DO VOO
dir_voo = 90 + random_range(-40, 40); //SAI PRA CIMA MEIO DE LADO E DEPOIS CURVA PRO ALVO
alvo = noone;		//NUMERO DO CENTRO (MODO "COLETAR")
atraso = 0;			//FRAMES A MAIS QUE O 10 FICA NO LUGAR DO BLOCO ANTES DE SAIR VOANDO (UM DE CADA VEZ)

//MORTE DA IRMANDADE
frame = 0;			//COR DO MINI-BLOCO (FRAME DA SPR_PECA)
esc_anel = 1;		//TAMANHO DO ANEL (MODO "ANEL")
ang = 0;	//ANGULO DO ESTILHAÇO
giro = 0;	//VELOCIDADE DO GIRO DO ESTILHAÇO

//NUMERO DO CENTRO ("COLETOR")
fase = "recebendo";	//"RECEBENDO" -> "SEGURANDO" -> VIRA "VOAR"
evento = 0;			//QUAL FECHAMENTO DE LINHA ESSE NUMERO REPRESENTA
total_real = 0;		//TOTAL (E O QUE JA FOI SOMADO NO PLACAR)
real_pendente = 0;	//PARTE DO TOTAL QUE AINDA TA VOANDO ATE AQUI (OS 10 DA IRMANDADE)
total_mostrado = 0;	//NUMERO QUE APARECE (VAI CONTANDO)
esperando = 0;		//10 DA IRMANDADE QUE AINDA NAO CHEGARAM
timer_espera = 0;	//TEMPO ESPERANDO OS 10 CHEGAREM
timer_vida = 0;		//SEGURANÇA: NUNCA FICA RECEBENDO MAIS QUE 5S
esc_pop = 1;		//"SOCO" DE ESCALA A CADA 10 QUE CHEGA

//TELEPORTE ("TELE")
y_chao = y;			//O CHAO ONDE A PEÇA CAIU
#macro TELE_DUR		18	//FRAMES DE VIDA DO EFEITO
