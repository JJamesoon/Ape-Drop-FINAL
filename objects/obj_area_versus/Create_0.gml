//GRADE DO VERSUS (RM_VERSUS): UMA ARENA LARGA (28 COLUNAS) COM DUAS ZONAS DE 10 COLUNAS, UMA PRA CADA JOGADOR (VERSUS_CRIAR, SCR_COOP).
//O QUE E IGUAL AO ARCADE (GRADE, PEÇAS, LINHAS) VEM DO OBJ_AREA. AQUI O VERSUS TROCA O FUNDO E A DETECÇAO DE LINHAS (POR ZONA) E DESENHA O HUD
versus_criar();
usa_borda = false;	//O HUD DO VERSUS E DESENHADO NO DRAW DESSE OBJETO (SEM O OBJ_BORDA DO ARCADE)
