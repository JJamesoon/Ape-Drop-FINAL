//BALA DO BLOCO LASER
//VELOCIDADE (A DIREÇAO E DADA POR QUEM ATIRA)
vel = 1.5;
velh = vel+1.5;
velv = vel+1.5;
//BLOCO QUE ATIROU
pai = noone;
refletida = false;	//O PODER DO REFLEXO REBATEU (NAO MACHUCA MAIS O PLAYER)
alvo = noone;		//BLOCO QUE A BALA REBATIDA VAI QUEBRAR
lateral = false;	//TIRO DO LASER LATERAL: VAI RETO E QUEBRA O PRIMEIRO BLOCO QUE ENCOSTAR (MENOS O QUE ATIROU)
//ONDE NASCEU (O TIRO ATRAVESSA OS BLOCOS CHAO COLADOS NO LASER PRA CONSEGUIR SAIR)
origem_x = x;
origem_y = y;
//FRAMES DE VIDA
timer = 15;
//ESCALA DA BALA (NASCE FININHA)
esc = .1;

