//MOEDA SOLTA NA ARENA (CRIADA PELO MOEDA_CRIAR): IGUAL AS LETRAS, SAI DO BLOCO COM UM PULINHO E DEPOIS FICA VOANDO
//DEVAGAR EM ZIGUE-ZAGUE PELA ARENA (BATE NAS BORDAS). NO COMEÇO E MAIS FACIL ELA IR PRA BAIXO (PRO LADO DO PLAYER).
//SOME DEPOIS DE MOEDA_VIDA (PISCA NO ULTIMO SEGUNDO). SO CONTA QUANDO O PLAYER PEGA: AI VOA ATE A CAIXINHA DO HUD
#macro MOEDA_VIDA			(room_speed * 9)	//TEMPO ATE SUMIR (ERA 4S)
#macro MOEDA_PEGAR			10					//FRAMES ATE O PLAYER PODER PEGAR (PRA ELA SAIR DO BLOCO ANTES)
#macro MOEDA_CHANCE_BAIXO	75					//CHANCE (0-100) DE, DEPOIS DO PULINHO, ELA COMEÇAR INDO PRA BAIXO

velh = random_range(.25, .45) * choose(-1, 1);	//ZIGUE-ZAGUE BEM DEVAGAR (CADA MOEDA NUMA VELOCIDADE PRA SE ESPALHAREM)
vel_zig = random_range(.2, .32);				//VELOCIDADE VERTICAL DO ZIGUE-ZAGUE
velv = random_range(-2, -1.4);					//PULINHO SAINDO DO BLOCO
saindo = true;	//AINDA NO PULINHO
timer = 0;	//FRAMES DE VIDA
frame = random(6);	//FRAME DA ANIMAÇAO (CADA MOEDA COMEÇA NUM)
esc = 1.6;	//NASCE UM POUCO GRANDE E ENCOLHE
pegou = false;	//O PLAYER JA PEGOU (VOANDO PRO HUD)

//VOO ATE O HUD (DEPOIS QUE O PLAYER PEGA)
vel = 0;
prox_x = x;
prox_y = y;
