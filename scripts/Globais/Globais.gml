//MACROS E VARIAVEIS GLOBAIS DO JOGO==================================
//CEL = TAMANHO DE UMA CELULA DA GRADE (PX), IMG_SPEED = VELOCIDADE DAS ANIMAÇOES, GRAVID = GRAVIDADE
#macro CEL 16
#macro IMG_SPEED .4
#macro GRAVID .22

//LIGA OS DEBUGS: CLICAR NA ARENA CRIA PEÇA, ALT+CLIQUE CRIA SOCO, TIMER NAS PEÇAS, ANDAR/LINHAS NA TELA
#macro DEBUG false
#macro IMORTAL true //PRA TESTAR: O PLAYER NAO PERDE VIDA NEM MORRE E A ARENA CHEIA SO LIMPA (DESLIGAR DEPOIS!)
#macro TESTE_AUTO false //TESTE AUTOMATICO DA GRADE/TELEPORTE (OBJ_TESTE_AUTO). LIGAR SO PRA TESTAR
#macro DEBUG_BLOCOS true //ENTER NO ARCADE PAUSA E ABRE O MENU PRA ESCOLHER QUAL BLOCO NASCE (DESLIGAR NO LANÇAMENTO!)
#macro TESTE_ENERGIA false //PRA TESTAR O PODER DE PARAR O TEMPO: A ENERGIA FICA SEMPRE CHEIA (DESLIGAR DEPOIS!)
#macro TESTE_ARCADE true //PRA TESTAR: PULA A INTRO E O MENU E ABRE DIRETO NO ARCADE (SEM MUDAR AS CHANCES DOS BLOCOS). DESLIGAR NO LANÇAMENTO!
#macro TESTE_COOP false //JUNTO COM O TESTE_BLOCOS: O ATALHO PRO ARCADE ABRE NO COOP (DOIS JOGADORES)
#macro TESTE_INICIO_LEVEL 1 //PRA TESTAR: A PARTIDA (ARCADE/COOP) JA COMEÇA NESSE LEVEL (1 = NORMAL. VOLTAR PRA 1 DEPOIS!)
#macro TESTE_INICIO_MINUTOS 0 //PRA TESTAR: A PARTIDA JA COMEÇA COM ESSES MINUTOS DE JOGO (0 = NORMAL. VOLTAR PRA 0 DEPOIS!)
#macro TESTE_BLOCOS false //PRA TESTAR OS BLOCOS NOVOS: O JOGO ABRE DIRETO NO ARCADE E GELO, COLMEIA, LENTO, GELATINA E BURACO
						 //APARECEM DESDE O COMEÇO E COM MAIS CHANCE (SCR_PONTOS). DESLIGAR DEPOIS!

global.coop = false; //MODO COOP: DOIS JOGADORES NO ARCADE (O MENU LIGA). NAO ZERA AO REINICIAR (SCR_COOP)
global.blocos_vistos = { normal : true };	//BLOCOS QUE O JOGADOR JA DESCOBRIU (PRA SEMPRE, NO SAVE: SCR_SAVE)
//ENSINO NATURAL (SCR_PODERES, NO FIM): O QUE O JOGADOR JA APRENDEU A FAZER (PRA SEMPRE, NO SAVE). SO ENSINA O QUE FALTA
global.habil = { mover : false, pulou : false, socou : false, soco_forte : false, girou : false, teleporte : false, giro_lat : false, linha : false, tempo : false };
global.vel_aviso = 0;			//0 A 1: VINHETA LARANJA QUANDO AS PEÇAS FICAM MAIS RAPIDAS (VAI SUMINDO SOZINHA)
global.habil_t = {};			//QUANDO (CURRENT_TIME) CADA COISA FOI DESCOBERTA NESSA SESSAO (A TECLA DA TIRA DE COMANDOS DA UMA PISCADINHA)
global.avisos_bloco = [];					//FILA DE AVISOS "NOVO BLOCO DESCOBERTO" (O OBJ_GAME_CONTROL MOSTRA UM DE CADA VEZ)
global.aviso_bloco_t = 0;					//FRAMES DO AVISO QUE TA NA TELA


//ZERA TUDO QUE E DA PARTIDA (CHAMADO NO COMEÇO DO JOGO E AO REINICIAR OU VOLTAR PRO MENU)
function restart_globais()
{
	global.game_pause = false;	//JOGO PAUSADO (MENU, MORTE, DESAFIO, HITSTOP)
	global.quebra_parado = false; //MODO QUEBRA-CABEÇA: TUDO PARADO (OBJ_QUEBRA_CABECA)
	global.qc_espera = QC_ESPERA_MIN; //TEMPO ATE ELE PODER APARECER SOZINHO
	global.qc_ritmo = 0; //LINHAS FECHADAS RECENTEMENTE (O QUEBRA-CABEÇA APARECE MAIS SE O JOGADOR TA INDO BEM)
	//ESTADOS DA ROOM
	global.bloco_especial = noone; //SE EXISTE UM BLOCO ESPECIAL NA ROOM
	global.debug_bloco = ""; //MENU DE DEBUG: BLOCO ESCOLHIDO PRA PROXIMA PEÇA ("" = SORTEIO NORMAL)
	
	//PLAYER 1--------------------
	//TREMIDA E EMPURRAOZINHO DA TELA
	global.shake_x = 0;
	global.shake_y = 0;
	global.lerp_y = 0;
	
	global.linhas_completadas	= 0;	//CONTROLA AS LINHAS QUE FORAM COMPLETADAS 
	global.andar				= 1;	//CONTROLA O ANDAR ATUAL DO GAME	(1, 2 E 3)
	global.level				= 1;    //CONTROLA O LEVEL ATUAL (QUANTAS VEZES CHEGOU ATE O 3 ANDAR)
	
	global.pontos_1		= 0;	//PONTOS DA PARTIDA
	global.pontos_pendentes = 0;	//PONTOS QUE AINDA TAO VOANDO ATE O HUD (O PLACAR SO SOBE QUANDO CHEGAM)
	global.coletor = noone;			//QUADRO DE PONTOS NO MEIO DA TELA
	global.evento_linha = 0;		//CONTA OS FECHAMENTOS DE LINHA (CADA UM TEM O SEU QUADRO)
	//PLAYER 1--------------------
	
	//PLAYER 2--------------------
	//TREMIDA E EMPURRAOZINHO DA TELA DO PLAYER 2
	global.shake_x_2 = 0;
	global.shake_y_2 = 0;
	global.lerp_y_2 = 0;
	
	global.linhas_completadas_2	= 0;	//CONTROLA AS LINHAS QUE FORAM COMPLETADAS 
	global.andar_2				= 1;	//CONTROLA O ANDAR ATUAL DO GAME	(1, 2 E 3)
	global.level_2				= 1;    //CONTROLA O LEVEL ATUAL (QUANTAS VEZES CHEGOU ATE O 3 ANDAR)
	
	global.pontos_2		= 0;	//PONTOS DO PLAYER 2
	//PLAYER 2--------------------
	//COOP--------------------
	global.pontos_coop		= 0;	//PONTOS DO COOP
	//COOP--------------------

	global.pause_timer = false	//UM TIMER QUE PAUSA O JOGO POR ALGUNS SEGUNDOS

	global.peca_inst = noone;	//ESSE E O ATUAL PECA INST
	global.prox_peca_int = [];  //UM ARRAY QUE GUARDAS SO PROX INST PECA
	
	global.ensino_t = 0;		//FRAMES DESDE O COMEÇO DA PARTIDA (O TEMPO_PARTIDA PODE COMEÇAR ADIANTADO NOS TESTES)
	global.tempo_partida	= 0;	//SEGUNDOS DA PARTIDA (APARECE NO HUD)
	global.efeito_lento		= 0;	//BLOCO ESPECIAL: PEÇAS DEVAGAR (FRAMES)
	global.efeito_rapido	= 0;	//BLOCO ESPECIAL: PEÇAS RAPIDAS (FRAMES)
	global.raio				= 0;	//BLOCO RAIO: FRAMES QUE OS OBJETOS AINDA FICAM AQUA COM OS PONTOS DOBRADOS
	global.raio_mix			= 0;	//0 A 1: QUANTO OS OBJETOS ESTAO AQUA AGORA (VAI E VOLTA SUAVE)
	global.bonus_moedas		= 0;	//BLOCO ESPECIAL: FRAMES QUE O MODO BONUS AINDA DURA (TODO BLOCO SOLTA MOEDA)
	
	//ENERGIA DO ESPECIAL (0 ATE ENERGIA_MAX, CADA 1 INTEIRO E UMA CARGA)
	global.energia = 0;
	global.especial_cadeia = 0;		//QUANTOS BLOCOS DO ESPECIAL JA MORRERAM NA ONDA ATUAL
	global.especial_restantes = 0;	//BLOCOS QUE AINDA VAO MORRER NA ONDA DO ESPECIAL
	
	//COMBO DE LINHAS EM SEQUENCIA
	global.combo_seq = 0;	//QUANTAS LINHAS SEGUIDAS DENTRO DO TEMPO
	global.combo_timer = 0;	//TEMPO PRA FECHAR A PROXIMA E CONTINUAR O COMBO
	
	//ALERTA DE PERIGO (BLOCOS PERTO DO TOPO)
	global.perigo = false;	//TEM BLOCO PARADO NAS 4 LINHAS DE CIMA?
	
	global.passou_andar2 = false;	//COMPLETOU O 2O ANDAR (DAI PRA FRENTE O JOGO FICA MAIS DIFICIL)
	global.emocao = 0;				//EXPRESSAO DO RETRATO NO HUD (EMOCAO_MOSTRAR, NO SCRIPT PERSONAGENS)
	global.emocao_timer = 0;	//FRAMES QUE A EXPRESSAO AINDA FICA
	global.febre = 0;				//FRAMES QUE FALTAM DA FEBRE (SCR_PONTOS)
	global.combo_linhas = 0;		//LINHAS FECHADAS NO COMBO ATUAL (3 = FEBRE)
	global.onda_timer = 0;			//FRAMES QUE AS PEÇAS AINDA CAEM 2X MAIS RAPIDO POR CAUSA DA ONDA
	global.altura_pilha = 0;		//0 = ARENA VAZIA, 1 = PILHA NO TOPO (A MUSICA ACELERA CONFORME SOBE)
	
	//COLECIONAVEIS D R O P E PODERES (SCR_PODERES). TUDO ZERA A CADA PARTIDA
	global.letras_nomes = ["A", "P", "E", "D", "R", "O", "P"]; //A PRIMEIRA PALAVRA E APEDROP. DEPOIS DO 1O PODER, SO DROP
	global.letras = array_create(array_length(global.letras_nomes), false);
	global.letra_pop = array_create(array_length(global.letras_nomes), 1);	//"POP" DA LETRA NO HUD QUANDO PEGA
	global.letras2 = array_create(array_length(global.letras_nomes), false);	//COOP: AS LETRAS DO PLAYER 2 (CADA JOGADOR TEM AS SUAS: GLOBAL.LETRAS E DO PLAYER 1)
	global.letra_pop2 = array_create(array_length(global.letras_nomes), 1);
	global.chegou_andar3 = false; //O BLOCO SNIPER SO APARECE DEPOIS QUE O JOGADOR CHEGA NO 3O ANDAR
	global.desafios_feitos = 0;	  //DESAFIOS (CUBO/MURO) QUE JA APARECERAM NA PARTIDA: CADA UM PEDE MAIS QUE O ANTERIOR
	global.poderes = [];	//PODERES QUE O PLAYER JA GANHOU (IDS)
	
	//CONTAGEM DE 3S ANTES DE ACELERAR (SCR_PONTOS)
	global.contagem = 0;	//FRAMES QUE FALTAM (0 = SEM CONTAGEM)
	global.contagem_texto = "";	//"MAIS RAPIDO", "FEBRE"...
	global.contagem_acao = undefined;	//FUNÇAO QUE RODA NO FIM DA CONTAGEM
	global.nivel_vel = 1;				//LEVEL QUE A VELOCIDADE DAS PEÇAS USA (SOBE SO DEPOIS DA CONTAGEM)
	global.febre_rapida = false;		//A FEBRE JA ACELEROU AS PEÇAS (DEPOIS DA CONTAGEM)
	global.congelar = 0;	//HITSTOP: FRAMES CONGELADOS (SCR_GAMEFEEL)
	global.andar_pausa = 0;	//SUBIU DE ANDAR: FRAMES COM O JOGO TODO PARADO (A REGUA VAI PRO LUGAR NOVO E TEM A FESTA, OBJ_LINHA)
	global.palavra_festa = 0;
	global.fundo_dano = 0;		//VINHETA VERMELHA NAS BORDAS QUANDO O PLAYER LEVA DANO (VAI SUMINDO)
	global.dupla_timer = 0;		//PEÇAS DUPLAS: FRAMES QUE AINDA FALTAM (CADA PEÇA VEM COM OUTRA LOGO ATRAS)
	global.pausa_real = false;	//PAUSA DE VERDADE (MENU, MORTE, HITSTOP...). NO TEMPO PARADO O JOGO PAUSA MAS O PLAYER ANDA
	global.tempo_fase = "";		//PODER DE PARAR O TEMPO: "" DESLIGADO, "parado" (SO O PLAYER ANDA), "contagem" (3S), "queda" (TUDO CAI)
	global.tempo_timer = 0;		//FRAMES QUE FALTAM DA FASE
	global.tempo_t = 0;			//FRAMES DESDE QUE O TEMPO PAROU (ANIMAÇOES)
	global.tempo_flash = 0;		//CLARAO VERDE DA TELA
	global.tempo_vis = 0;		//0 A 1: QUANTO A TELA TA VERDE (SHADER)
	global.tempo_cx = 0;		//ONDE O TEMPO PAROU (OS ANEIS DO RELOGIO SAEM DAI)
	global.tempo_cy = 0;
	global.tempo_sombras = [];	//FEIXE E SOMBRA VERDE DO TELEPORTE DO TEMPO PARADO (UM POR BLOCO QUE CAIU)
	global.tempo_rastros = [];	//LINHAS FRACAS DA PREVIA DA QUEDA: [X, Y1, Y2] (UMA POR COLUNA)
	global.tempo_dicas = [];	//BLOCOS QUE BRILHAM NO TEMPO PARADO (GRUPOS QUE COMPLETAM UMA LINHA QUANDO CAIREM)
	//COMPLETOU A PALAVRA: FRAMES DA FESTA DAS LETRAS NO PAINEL (O JOGO PARA) ANTES DO MENU DE PODER
	global.peca_acelerada = noone;		//PEÇA QUE O PLAYER TA FAZENDO DESCER (SEGURANDO BAIXO EM CIMA DELA)
	global.peca_acelerada_timer = 0;					//FRAMES CONGELADOS (SCR_GAMEFEEL)
	global.ondas_choque = [];	//ONDAS DE CHOQUE NA TELA (SCR_GAMEFEEL)
	global.calor = [];			//CALOR DOS LASERS NA TELA (SCR_GAMEFEEL)
	global.flash_linha = 0;			//FLASH BRANCO SUTIL QUANDO FECHA LINHA
	
	//ESTATISTICAS DA PARTIDA (TELA DE RESULTADO)
	global.moedas_partida		= 0;
	global.blocos_destruidos	= 0;
	global.linhas_total			= 0;
	
	//PROXIMA PEÇA QUE VAI NASCER (APARECE NO HUD)
	peca_sortear_proxima();

}
//SEM ISSO O GAMEMAKER USA SEMPRE A MESMA SEMENTE E TODA PARTIDA COMEÇA COM AS MESMAS PEÇAS
//(NO TESTE AUTOMATICO FICA FIXA DE PROPOSITO, PRA DAR SEMPRE O MESMO RESULTADO)
if(!TESTE_AUTO) randomize();
//ZERA TUDO QUANDO O JOGO ABRE
restart_globais();
