//DEVOLVE O TEXTO DA CHAVE NO IDIOMA ATUAL
function texto(_chave)
{
	var _idioma = clamp(global.linguagem, 0, array_length(global.textos) - 1);
	return global.textos[_idioma][$ _chave];
}
